if(NOT EXISTS "${INPUT_FILE}")
    message(FATAL_ERROR "Private dependency verification requires INPUT_FILE")
endif()
if(INPUT_FILE MATCHES "\\.dll$")
    execute_process(COMMAND "${OBJDUMP_TOOL}" -p "${INPUT_FILE}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE headers ERROR_VARIABLE error)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "Cannot inspect JNI DLL: ${error}")
    endif()
    if(headers MATCHES "DLL Name: [^\n]*(ssl|crypto|mimalloc)[^\n]*\\.dll")
        message(FATAL_ERROR "JNI must not depend on shared OpenSSL or mimalloc DLLs")
    endif()
    if(headers MATCHES "DLL Name: [^\n]*(libstdc\\+\\+|libgcc_s|libc\\+\\+)[^\n]*\\.dll")
        message(FATAL_ERROR "Desktop JNI must embed its C++ runtime")
    endif()
    set(imports "${headers}")
    foreach(export_marker IN ITEMS "The Export Tables" "[Ordinal/Name Pointer] Table")
        string(FIND "${imports}" "${export_marker}" export_start)
        if(NOT export_start EQUAL -1)
            string(SUBSTRING "${imports}" 0 ${export_start} imports)
        endif()
    endforeach()
    if(imports MATCHES "[ \t](malloc|calloc|realloc|free|_?strdup)[\r\n]")
        message(FATAL_ERROR "Desktop JNI must resolve C heap requests inside the private library")
    endif()
    string(REPLACE "\n" ";" lines "${headers}")
    set(exports "")
    set(in_names FALSE)
    foreach(line IN LISTS lines)
        if(line MATCHES "^\\[Ordinal/Name Pointer\\] Table")
            set(in_names TRUE)
        elseif(in_names AND line MATCHES "^[ \t]*Ordinal[ \t]+Hint[ \t]+Name[ \t\r]*$")
            # Recent binutils prints column headings and an explicit ordinal base.
            continue()
        elseif(in_names AND line MATCHES "^[ \t]*\\[[ \t]*[0-9]+\\][ \t]+\\+base\\[[ \t]*[0-9]+\\][ \t]+[0-9a-fA-F]+[ \t]+([^ \t\r]+)")
            list(APPEND exports "${CMAKE_MATCH_1}")
        elseif(in_names AND line MATCHES "^[ \t]*\\[[ \t]*[0-9]+\\][ \t]+([^ \t\r]+)")
            list(APPEND exports "${CMAKE_MATCH_1}")
        elseif(in_names AND NOT line MATCHES "^[ \t\r]*$")
            break()
        endif()
    endforeach()
else()
    if(PLATFORM MATCHES "Darwin|iOS")
        set(flags -gUm)
        set(macho TRUE)
        if(NOT STATIC_ARCHIVE)
            execute_process(COMMAND "${OTOOL_TOOL}" -L "${INPUT_FILE}"
                RESULT_VARIABLE rc OUTPUT_VARIABLE headers ERROR_VARIABLE error)
            if(NOT rc EQUAL 0 OR headers MATCHES "lib(ssl|crypto|[^/ \n]*mimalloc|c\\+\\+)[^\n]*\\.dylib")
                message(FATAL_ERROR "JNI must embed OpenSSL and mimalloc: ${error} ${headers}")
            endif()
        endif()
        if(STATIC_ARCHIVE AND PLATFORM STREQUAL "iOS")
            set(flags -m)
        endif()
    else()
        set(flags -D --defined-only)
        execute_process(COMMAND "${OBJDUMP_TOOL}" -p "${INPUT_FILE}"
            RESULT_VARIABLE rc OUTPUT_VARIABLE headers ERROR_VARIABLE error)
        if(NOT rc EQUAL 0 OR headers MATCHES "NEEDED[^\n]*(ssl|crypto|mimalloc)")
            message(FATAL_ERROR "JNI must embed OpenSSL and mimalloc: ${error} ${headers}")
        endif()
        if(headers MATCHES "FLAGS[^\n]*STATIC_TLS")
            message(FATAL_ERROR "JNI requires dlopen-compatible thread-local storage, not initial-exec TLS")
        endif()
        if(PLATFORM STREQUAL "Linux" AND headers MATCHES "NEEDED[^\n]*(libstdc\\+\\+|libc\\+\\+|libgcc_s)")
            message(FATAL_ERROR "Desktop JNI must embed its C++ runtime")
        endif()
    endif()
    execute_process(COMMAND "${NM_TOOL}" ${flags} "${INPUT_FILE}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE symbols ERROR_VARIABLE error)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "Cannot inspect JNI exports: ${error}")
    endif()
    if(PLATFORM STREQUAL "Android")
        execute_process(COMMAND "${NM_TOOL}" --defined-only "${INPUT_FILE}"
            RESULT_VARIABLE allocator_rc OUTPUT_VARIABLE allocator_symbols)
        if(NOT allocator_rc EQUAL 0 OR allocator_symbols MATCHES "[ \t]_?mi_[A-Za-z0-9_]+([ \t\r\n]|$)")
            message(FATAL_ERROR "Android must use the platform allocator without mimalloc")
        endif()
    endif()
    if(STATIC_ARCHIVE AND symbols MATCHES "\\(common\\)")
        message(FATAL_ERROR "Static JNI must materialize common definitions before making them private")
    endif()
    if(PLATFORM STREQUAL "iOS" AND symbols MATCHES "[ \t]_+mi_[A-Za-z0-9_]+([ \t\r\n]|$)")
        message(FATAL_ERROR "iOS must use the platform allocator without mimalloc")
    endif()
    string(REPLACE "\n" ";" lines "${symbols}")
    set(exports "")
    foreach(line IN LISTS lines)
        # Darwin nm also prints private-external definitions with -g.
        if(macho AND line MATCHES "[ \t]external[ \t]" AND NOT line MATCHES "private external|\\(undefined\\)")
            string(REGEX REPLACE ".*[ \t]([^ \t\r]+)$" "\\1" symbol "${line}")
            list(APPEND exports "${symbol}")
        elseif(NOT macho AND line MATCHES "^[0-9a-fA-F]+[ \t]+[A-Za-z][ \t]+([^ \t\r]+)")
            list(APPEND exports "${CMAKE_MATCH_1}")
        endif()
    endforeach()
endif()
if(NOT exports)
    message(FATAL_ERROR "No JNI exports found; refusing an unverified native artifact")
endif()
foreach(symbol IN LISTS exports)
    if(NOT symbol MATCHES "^_?(Java_.+|JNI_OnLoad|JNI_OnUnload|get_jni_env_from_jvm)(@[0-9]+)?$")
        message(FATAL_ERROR "Non-JNI symbol escapes the private native library: ${symbol}")
    endif()
endforeach()
message(STATUS "Private dependencies verified: no shared OpenSSL/mimalloc and only JNI exports")
